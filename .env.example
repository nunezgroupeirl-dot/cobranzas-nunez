# Copia este archivo como .env.local (desarrollo) y pega los datos de Supabase:
# Supabase → Project Settings → API → Project URL y la llave "anon public".
# NUNCA pongas aquí la llave service_role: el frontend es público.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: 1 = usar datos de prueba en el navegador aunque haya Supabase configurado
# (útil para una demo). Sin URL ni llave, `npm run dev` usa datos de prueba solo.
NEXT_PUBLIC_MODO_PRUEBA=
